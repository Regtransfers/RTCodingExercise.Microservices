@model List<Catalog.Domain.Plate>

@{
    ViewData["Title"] = "Plates";
}

<form method="get" class="mb-3">
    <div class="input-group">
        <input name="filter" value="@Context.Request.Query["filter"]" class="form-control" placeholder="Filter" />
        <select name="orderBy" class="form-select">
            <option value="">Order</option>
            <option value="price" @(Context.Request.Query["orderBy"] == "price" ? "selected" : "")>Price</option>
        </select>
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Registration</th>
            <th>Purchase Price</th>
            <th>Sale Price</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
@foreach (var plate in Model)
{
        <tr>
            <td>@plate.Registration</td>
            <td>@plate.PurchasePrice.ToString("C")</td>
            <td>@plate.SalePrice.ToString("C")</td>
            <td>@plate.Status</td>
        </tr>
}
    </tbody>
</table>
